// Pipeline do MS Moradores (NestJS 10 + Prisma 7, Node 24) — agente LINUX (usa sh e docker compose).
// Mesmo padrão do projeto HemoVida-estoque: busca os segredos no Infisical (token de acesso do projeto, guardado no
// Jenkins como a credencial "tokenbernardocondominio"), grava num .env temporário e sobe o container com docker compose.
// O .env é apagado no fim do pipeline (post/always), então nenhum segredo fica salvo no disco do Jenkins.
// Para agente Windows existe o arquivo "Jenkinsfile".
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        APP_NAME             = 'moradores-proptech'   // = container_name do docker-compose.yml
        APP_PORT             = '7522'
        INFISICAL_PROJECT_ID = '70db4fbb-c0a2-4296-b9ad-730ebf55bb62'  // projeto "Morador" (não é segredo)
        INFISICAL_ENV        = 'dev'                  // ambiente do Infisical (slug: dev/prod)
        INFISICAL_PATH       = '/'                    // pasta dos segredos dentro do ambiente
    }

    stages {

        stage('Checkout GitHub') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/feat/prisma-7']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/BeSenna/Moradores-Proptech'
                    ]]
                ])
            }
        }

        stage('Fetch Secrets - Infisical') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'tokenbernardocondominio',
                        variable: 'INFISICAL_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu
                        umask 077

                        rm -f .env

                        npx -y @infisical/cli export \
                            --projectId="$INFISICAL_PROJECT_ID" \
                            --env="$INFISICAL_ENV" \
                            --path="$INFISICAL_PATH" \
                            --token="$INFISICAL_TOKEN" \
                            > .env

                        test -s .env || {
                            echo "ERRO: Arquivo .env não foi gerado."
                            exit 1
                        }

                        echo "Secrets carregados com sucesso."
                    '''
                }
                // O infisical export envolve os valores em aspas SIMPLES (ex: DATABASE_URL='mysql://...').
                // Este passo remove as aspas (simples ou duplas) do .env para que o valor chegue limpo ao container.
                sh "sed -i -E \"s/^([^=]+)=['\\\"](.*)['\\\"]\$/\\\\1=\\\\2/\" .env"
            }
        }

        stage('Validar Docker Compose') {
            steps {
                sh '''
                    set -eu

                    docker compose config --quiet

                    echo "Docker Compose validado."
                '''
            }
        }

        stage('Construir Imagem Docker') {
            steps {
                sh '''
                    set -eu

                    docker compose build api

                    echo "Imagem Docker construída."
                '''
            }
        }

        stage('Deploy Docker') {
            steps {
                sh '''
                    set -eu

                    # --no-deps: sobe só a API (o RabbitMQ do compose é para uso local; no servidor vale o RABBITMQ_URL do Infisical)
                    docker compose up -d --no-build --no-deps --force-recreate api

                    echo "Deploy executado."
                '''
            }
        }

        stage('Verificar Container') {
            steps {
                sh '''
                    set -eu

                    echo "Verificando container..."

                    sleep 10

                    RUNNING=$(docker inspect --format '{{.State.Running}}' "$APP_NAME")

                    if [ "$RUNNING" != "true" ]; then
                        echo "ERRO: Container não está rodando."
                        docker logs --tail 50 "$APP_NAME" || true
                        exit 1
                    fi

                    echo "Container em execução."
                    docker compose ps

                    echo "Versão do Node.js no container:"
                    docker exec "$APP_NAME" node -v
                '''
                // Falha aqui deixa o build "instável" (amarelo), sem derrubar o deploy já feito.
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    sh '''
                        docker exec "$APP_NAME" node -e "const t=async()=>{for(let i=0;i<15;i++){try{const r=await fetch('http://localhost:7522/condominio/morador/docs');if(r.ok){console.log('API respondendo.');return}}catch(e){}await new Promise(r=>setTimeout(r,3000))}console.log('API não respondeu a tempo.');process.exit(1)};t()" || {
                            docker logs --tail 40 "$APP_NAME" || true
                            exit 1
                        }
                    '''
                }
            }
        }
    }

    post {

        success {
            echo '''
            ====================================
             MS MORADORES - PROPTECH
             DEPLOY EXECUTADO COM SUCESSO
             PORTA: 7522
            ====================================
            '''
        }

        failure {
            echo '''
            ====================================
             MS MORADORES - PROPTECH
             FALHA NA EXECUÇÃO DO PIPELINE
            ====================================
            '''
        }

        always {
            // Remove o .env do workspace para não deixar segredos em texto puro no disco do Jenkins
            sh '''
                set +x
                rm -f .env
            '''
        }
    }
}
