# Este arquivo é só um MODELO. Copie para .env (que não vai para o Git) ou, melhor, use o Infisical:
#   npm run start:dev          (usa o Infisical)
# As variáveis abaixo existem no Infisical (ambiente "dev"); não escreva senhas reais aqui.

# MySQL 5.7 do servidor da faculdade (usuário, senha e banco vêm do Infisical)
# Formato: mysql://USUARIO:SENHA@edumysql.acesso.rj.senac.br:3306/20262m_prj5_condominio_morador
DATABASE_URL="mysql://usuario:senha@edumysql.acesso.rj.senac.br:3306/20262m_prj5_condominio_morador"

# Porta do microsserviço (rotas sob /condominio/morador)
PORT=7522

# JWT — a mesma chave deve ser configurada nos outros microsserviços (Financeiro, Serviços)
# para que todos validem o token emitido por este serviço
JWT_SECRET="troque-por-um-segredo-forte-e-unico"
JWT_EXPIRES_IN="8h"

# RabbitMQ — broker de eventos compartilhado entre os 3 microsserviços
# (publica morador.cadastrado, imovel.cadastrado, morador_imovel.vinculado)
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Síndico inicial — criado automaticamente na primeira subida, se ainda não houver síndico ativo.
# (ADMIN_SENHA precisa ter pelo menos 8 caracteres; sem ela nenhum usuário é criado)
ADMIN_LOGIN="admin"
ADMIN_SENHA="troque-esta-senha"
