# MySQL — banco condominio_moradores
DATABASE_URL="mysql://usuario:senha@localhost:3306/condominio_moradores"

# Porta do microsserviço
PORT=3001

# JWT — mesma chave deve ser configurada nos outros microsserviços (Financeiro, Serviços)
# para que todos validem o token emitido por este serviço
JWT_SECRET="troque-por-um-segredo-forte-e-unico"
JWT_EXPIRES_IN="8h"

# RabbitMQ — broker de eventos compartilhado entre os 3 microsserviços
# (publica morador.cadastrado, imovel.cadastrado, morador_imovel.vinculado)
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
